# Copy to .env for local development (never commit the real .env — it's gitignored).
# dotenv is installed and loaded automatically by server.js.

# Supabase project → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-secret-key   # server-side only, full DB access

# JWT signing secret — anything long/random for local dev
JWT_SECRET=dev_only_change_in_prod

# Phone OTP login is deferred (needs DLT registration for Indian SMS) — see
# git history / conversation notes for the MSG91 integration to resume later.
